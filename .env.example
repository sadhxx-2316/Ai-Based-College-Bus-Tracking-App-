# ==============================================================================
# Production Deployment Environment Variables
# ==============================================================================

# 1. Project & Security
PROJECT_NAME="AI-Enabled College Bus Tracking and Smart ETA Prediction System"
JWT_SECRET="generate-a-strong-random-secret-key-for-production-use"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 2. Database (MongoDB)
# If using Docker Compose, keep default: mongodb://mongodb:27017
# If using MongoDB Atlas, use: mongodb+srv://<user>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=college_bus_tracking

# 3. External API Keys (Optional - Free fallback routing is built-in)
GOOGLE_MAPS_SERVER_KEY=
VITE_GOOGLE_MAPS_BROWSER_KEY=

# 4. CORS Origins (Comma-separated or JSON list of authorized frontend domains)
# Example: ["https://bus.college.edu", "http://localhost"]
CORS_ORIGINS=["*"]
