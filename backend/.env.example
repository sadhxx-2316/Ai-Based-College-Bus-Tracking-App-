# Project Environment Configuration
PROJECT_NAME="AI-Enabled College Bus Tracking and Smart ETA Prediction System"
API_V1_STR=/api

# MongoDB Configuration
# Local MongoDB connection or MongoDB Atlas URI:
# e.g., mongodb://localhost:27017 or mongodb+srv://<user>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=college_bus_tracking

# Firebase Configuration
# Enable Firebase Auth in Firebase Console, then download serviceAccountKey.json if running on server:
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
DEV_AUTH_BYPASS=true

# Google Maps / Places / Routes API Server Key
# Used for backend road routing and distance calculations:
GOOGLE_MAPS_SERVER_KEY=

# Operational GPS and Arrival Thresholds
ARRIVAL_RADIUS_METERS=100.0
GPS_STALE_AFTER_SECONDS=60
GPS_MAX_AGE_SECONDS=30
GPS_MAX_ACCURACY_METERS=60.0
SPEED_ANOMALY_KMH_THRESHOLD=90.0
MAX_PLAUSIBLE_JUMP_SPEED_KMH=130.0

# Stop Proximity Alert Thresholds
APPROACHING_STOP_METERS=500.0
APPROACHING_STOP_SECONDS=180.0

# Session & JWT Secret
JWT_SECRET=college-bus-tracking-jwt-secret-key-2026-production
JWT_ALGORITHM=HS256
